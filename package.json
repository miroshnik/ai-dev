{
  "name": "ai-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Общие правила и скиллы для агентов; установка — npx github:miroshnik/ai-dev install; скрипты скиллов — TypeScript под Bun, тесты — bun test в tests/",
  "bin": {
    "ai-dev": "bin/ai-dev.mjs"
  },
  "files": [
    "bin",
    "AGENTS.md",
    "claude",
    "docs/*.md",
    "skills"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "test": "bun test",
    "test:spec": "bun test tests/standards",
    "typecheck": "tsc --noEmit",
    "spec:doc": "bun test --reporter=junit --reporter-outfile=.spec-report.xml && bun skills/spec/scripts/spec-doc.ts .spec-report.xml --strict",
    "spec:diff": "bun skills/spec/scripts/spec-diff.ts",
    "spec:publish": "bun skills/spec/scripts/spec-publish.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript": "^7.0.2"
  }
}
