{
  "name": "ai-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A development flow with AI agents: shared rules and skills for any agent; install — bunx github:miroshnik/ai-dev install; the installer and skill scripts — TypeScript under Bun, tests — bun test in tests/",
  "bin": {
    "ai-dev": "bin/ai-dev.ts"
  },
  "files": [
    "bin",
    "AGENTS.md",
    "claude",
    "docs/*.md",
    "skills"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "test": "bun --no-env-file skills/slot/scripts/slot.ts 'bun test --path-ignore-patterns=\"**/*.slow.test.ts\"'",
    "test:slow": "bun --no-env-file skills/slot/scripts/slot.ts 'bun test .slow.test.ts'",
    "test:spec": "bun --no-env-file skills/slot/scripts/slot.ts 'bun test tests/standards'",
    "typecheck": "bun --no-env-file skills/slot/scripts/slot.ts 'bun check'",
    "spec:doc": "bun test --reporter=junit --reporter-outfile=.spec-report.xml && bun --no-env-file skills/spec/scripts/spec-doc.ts .spec-report.xml --strict",
    "spec:diff": "bun --no-env-file skills/spec/scripts/spec-diff.ts",
    "spec:publish": "bun --no-env-file skills/spec/scripts/spec-publish.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0"
  }
}
